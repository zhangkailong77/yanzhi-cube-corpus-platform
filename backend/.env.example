# ============================================
# 环境变量配置
# ============================================

# 数据库配置
DB_HOST=192.168.31.11
DB_PORT=3306
DB_USER=root
DB_PASSWORD=123456
DB_NAME=corpus_management

# JWT 配置
# 生产环境请使用强密钥（至少 32 字符随机字符串）
SECRET_KEY=your-super-secret-key-change-this-in-production-min-32-chars
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# 应用配置
APP_NAME=语料库管理平台
DEBUG=True

# CORS 配置（多个域名用逗号分隔）
ALLOWED_ORIGINS=http://localhost:3001
